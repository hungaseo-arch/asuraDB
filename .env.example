# ============================================================
# AsuraDB — 환경변수 템플릿
#
# 이 파일을 `.env`로 복사한 뒤 실제 값으로 채우세요.
#   cp .env.example .env
#
# 보안 규칙:
#   - `VITE_` 접두사 변수는 Vite 빌드 결과에 그대로 포함되어 브라우저에 노출됩니다.
#     → 노출돼도 안전한 값(publishable/anon 키 등)만 사용.
#   - service_role 키 / API 비밀키는 절대 `VITE_` 접두사 금지.
# ============================================================

# ── Supabase — 프런트엔드 (브라우저 번들 포함) ──────────────────
VITE_SB_URL=https://<project-ref>.supabase.co
VITE_SB_KEY=sb_publishable_xxxx          # publishable(=anon 대체) 키 또는 레거시 eyJ... JWT
                                          # Dashboard → Settings → API → "anon public" / Publishable keys

# ── Supabase — 서버/수집기 전용 (절대 노출 금지) ────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=eyJ...               # service_role 키 (RLS 우회)
                                          # 사용처: Edge Function · api/search.py · collectors/*.py · scripts/

# ── Claude (Anthropic) — AI 추론 공통 ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-...              # https://console.anthropic.com/ → API Keys
CLAUDE_MODEL_SEARCH=claude-haiku-4-5-20251001  # /ai-search · /report 모델 (기본값)
CLAUDE_MODEL_AGENT=claude-sonnet-4-6             # 주간 모니터링 리포트 / 향후 MCP Agent

# ── Google OAuth — Drive · Gmail · Calendar 공용 ──────────────
# 발급: https://console.cloud.google.com/ → APIs & Services → Credentials → OAuth 2.0 Client ID (Desktop)
# 인증 1회 실행: uv run python scripts/google_auth.py → 루트에 token.json 생성
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://localhost:9090/    # google_auth.py 가 동적 포트 사용 — 기본값 무관

# ── Notion 수집기 ──────────────────────────────────────────────
# 발급: https://www.notion.so/profile/integrations
# 수집할 데이터베이스를 해당 Integration에 "Connections"로 공유해야 함.
NOTION_API_KEY=secret_...
NOTION_DATABASE_IDS=db1_id,db2_id            # 쉼표 구분 — 페이지 ID 아닌 "데이터베이스" ID

# ── UpNote 수집기 ──────────────────────────────────────────────
# UpNote → Export 폴더 경로. 절대경로 권장 (~ 자동 확장 안 됨).
UPNOTE_EXPORT_DIR=/Users/<you>/Desktop/upnote_export

# ── Naver Band 수집기 ──────────────────────────────────────────
# 발급: https://developers.naver.com/apps/ → Band Open API
BAND_ACCESS_TOKEN=...

# ── BPS WebAPI — 인도네시아 통계청 (물가 CPI · 타이어 수입통계) ──
# 발급: https://webapi.bps.go.id → 가입 → [API KEY] 탭에서 키 복사
# 사용처: collectors/bps_collector.py(CPI) · collectors/bps_import_collector.py(tire_imports)
BPS_API_KEY=...

# ── 임베딩 모델 (Python 검색 백엔드) ────────────────────────────
# SentenceTransformer 모델명. 변경 시 hybrid_search RPC 의 vector(384) 차원도 맞춰야 함.
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
